{
  "name": "escape-police",
  "productName": "Escape Police - Cyber Pursuit",
  "version": "1.0.0",
  "description": "Retro-futuristic police pursuit racing game standalone desktop edition",
  "author": "Escape Police Team <mhasy.gaming@gmail.com>",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "vite build",
    "build:electron": "ELECTRON_BUILD=true vite build",
    "electron:dev": "electron .",
    "electron:build": "ELECTRON_BUILD=true vite build && electron-builder --win nsis",
    "electron:pack": "ELECTRON_BUILD=true vite build && electron-builder --win --dir",
    "deploy:vercel": "vercel --prod",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.escapepolice.cyberpursuit",
    "productName": "Escape Police - Cyber Pursuit",
    "copyright": "Copyright © 2026 Escape Police",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "main.js",
      "preload.js",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Escape Police",
      "uninstallDisplayName": "Escape Police - Cyber Pursuit",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^14.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "peerjs": "^1.5.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_dark">

    <!-- Primary Fullscreen Game Canvas WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cyber_dark" />

    <!-- Sleek Top Progress Bar Indicator for Initial Page Load -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/cyber_cyan"
        android:visibility="gone" />

    <!-- Offline & Error Fallback Container with Cyberpunk Styling -->
    <LinearLayout
        android:id="@+id/offlineContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESCAPE POLICE"
            android:textColor="@color/cyber_cyan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/offline_title"
            android:textColor="@color/cyber_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="360dp"
            android:text="@string/offline_message"
            android:textColor="@color/cyber_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/cyber_cyan"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/retry_button"
            android:textColor="@color/cyber_dark"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
